{
    "name": "youwilllikeit/silverstripe-gridfield-toolkit",
    "description": "Advanced UX/UI components for the Silverstripe CMS GridField: inline editing, undo, and more.",
    "type": "silverstripe-vendormodule",
    "license": "proprietary",
    "keywords": ["silverstripe", "gridfield", "cms", "inline-edit", "ux"],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/admin": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "YouWillLikeIT\\GridFieldToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YouWillLikeIT\\GridFieldToolkit\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "scripts": {
        "lint": "phpcs src tests/php",
        "test": "phpunit",
        "build": "npm run build"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
